// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

// ==========================================
// 1. ADMIN MODEL
// ==========================================
model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @default("Store Admin")
  email     String   @unique
  password  String
  role      String   @default("superadmin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// ==========================================
// 2. USER MODEL (Customers)
// ==========================================
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  phone     String?  @default("")
  role      String   @default("customer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ==========================================
// 3. PRODUCT MODEL
// ==========================================
model Product {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  category    String // "Tissue Paper", "Kitchen Roll", "Toilet Roll", "Face Tissue"
  price       Float // Base price for smallest pack
  image       String
  tagline     String?
  description String?
  specs       String[]
  ply         String           @default("2-Ply")
  material    String           @default("100% Virgin Pulp")
  stock       Int              @default(50)
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("products")
}

// Embedded Product Variant Type
type ProductVariant {
  size       String // e.g. "Pack of 2", "Pack of 4", "Pack of 6", "Pack of 12"
  price      Float
  stock      Int     @default(20)
  unitWeight String? // e.g. "100 Pulls per box", "200 Sheets per roll"
}

// ==========================================
// 4. ORDER MODEL
// ==========================================
model Order {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  customer          CustomerInfo
  items             OrderItem[]
  totalAmount       Float
  razorpayOrderId   String
  razorpayPaymentId String?
  razorpaySignature String?
  status            String       @default("created") // "created", "paid", "processing", "shipped", "delivered", "failed"
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("orders")
}

// Embedded Customer Info Type
type CustomerInfo {
  name    String
  email   String
  phone   String
  address String
  city    String
  state   String
  pincode String
}

// Embedded Order Item Type
type OrderItem {
  product  String? // Product ObjectId string
  name     String
  price    Float
  quantity Int     @default(1)
  image    String?
}

// ==========================================
// 5. QUERY MODEL (Customer Support / B2B Quotes)
// ==========================================
model Query {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String
  phone       String
  inquiryType String   @default("Household / Personal Order")
  message     String
  status      String   @default("new") // "new", "in_progress", "responded", "closed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("queries")
}
